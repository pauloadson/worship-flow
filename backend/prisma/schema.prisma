// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  phone         String?
  password_hash String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedGroups Group[]       @relation("GroupOwner")
  memberships GroupMember[]
}

model Group {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User     @relation("GroupOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles   Role[]
  members GroupMember[]
  songs   Song[]
  events  Event[]
  recurringSchedules RecurringSchedule[]
}

model Role {
  id      String @id @default(uuid())
  groupId String
  name    String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  members GroupMember[]

  @@unique([groupId, name])
}

model GroupMember {
  userId  String
  groupId String
  roleId  String?
  isAdmin Boolean @default(false)

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role  Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  rsvps EventRsvp[]

  @@id([userId, groupId])
}

model Song {
  id             String  @id @default(uuid())
  groupId        String
  title          String
  artist         String?
  key            String?
  lyrics         String? @db.Text
  chords         String? @db.Text
  sheetMusicUrl  String?
  videoLessonUrl String?
  audioUrl       String?
  group          Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  events         EventSong[]
}

model Event {
  id        String   @id @default(uuid())
  groupId   String
  title     String
  date      DateTime
  eventType String? // e.g. "Ensaio" or "Culto"
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  rsvps EventRsvp[]
  songs EventSong[]

  @@unique([groupId, date])
}

model EventSong {
  id      String @id @default(uuid())
  eventId String
  songId  String
  order   Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  song  Song  @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([eventId, songId])
}

model RecurringSchedule {
  id        String   @id @default(uuid())
  groupId   String
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  time      String   // "HH:mm"
  title     String
  eventType String?
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model EventRsvp {
  id        String  @id @default(uuid())
  eventId   String
  userId    String
  groupId   String
  status    String  @default("pending") // pending, accepted, declined
  role      String? // e.g. "Bateria", "Vocal"
  tokenLink String? @unique

  event  Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member GroupMember @relation(fields: [userId, groupId], references: [userId, groupId], onDelete: Cascade)

  @@unique([eventId, userId])
}
