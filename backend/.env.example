# Ambiente (development ou production)
NODE_ENV="development"

# Configurações do Banco de Dados MySQL
DATABASE_URL="mysql://root:suasenha@localhost:3306/worship_flow"

# JWT Auth Secret
JWT_SECRET="um-segredo-super-seguro-aqui-123"

# Porta do Servidor
PORT=3001

# Chave de seguranca da API
API_KEY="sua-chave-api-123"

# Google Gemini AI (gere em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="sua-chave-gemini-aqui"

# Limites internos para proteger a cota gratuita do projeto Gemini.
# Confira os limites efetivos no Google AI Studio e reduza estes valores se necessário.
GEMINI_PROJECT_RPM=5
GEMINI_PROJECT_RPD=100
